# 🔐 GMAIL EMAIL CONFIGURATION
# ⚠️ IMPORTANT: Never commit this file to version control!

# Gmail Email Settings (MUST use App Password, not regular password!)
SENDER_EMAIL=your-email
SENDER_PASSWORD=your-16-digits-password
RECIPIENT_EMAIL=receipient-email

# Gmail SMTP Configuration (Optimized for reliability)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Optional: Email Subject Customization
EMAIL_SUBJECT=📊 Automated Sales Report - Data Pipeline Demo

# 🚨 CRITICAL GMAIL SETUP STEPS:
# 1. Go to Google Account settings
# 2. Enable 2-Factor Authentication
# 3. Go to Security > App passwords
# 4. Generate new app password for "Mail"
# 5. Use that 16-character password above (remove spaces)
# 6. NEVER use your regular Gmail password - it won't work!